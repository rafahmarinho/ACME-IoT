# Supabase Configuration
# Used by React Native (Expo) Web & Mobile apps
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Service Role Key (Only used by backend API endpoints on Vercel)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# IoT Ingestion API Endpoint (Optional: defaults to /api when hosted on Vercel)
EXPO_PUBLIC_API_URL=https://your-deployment.vercel.app/api
